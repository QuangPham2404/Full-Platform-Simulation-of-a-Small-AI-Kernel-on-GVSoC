diff --git a/models/cpu/iss/include/isa/rv64i.hpp b/models/cpu/iss/include/isa/rv64i.hpp
index 3cf0cd14..571a08af 100644
--- a/models/cpu/iss/include/isa/rv64i.hpp
+++ b/models/cpu/iss/include/isa/rv64i.hpp
@@ -143,3 +143,12 @@ static inline iss_reg_t sraw_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc)
     REG_SET(0, LIB_CALL2(lib_SRAW, REG_GET(0), REG_GET(1) & ((1 << 5) - 1)));
     return iss_insn_next(iss, insn, pc);
 }
+
+// Custom-0 MAC, modulo 2^32; zero-extend the result in the RV64 register.
+static inline iss_reg_t mac_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc)
+{
+    const uint32_t result = (uint32_t)REG_GET(2)
+        + (uint32_t)REG_GET(0) * (uint32_t)REG_GET(1);
+    REG_SET(0, (iss_reg_t)result);
+    return iss_insn_next(iss, insn, pc);
+}
